afia.md"},"c4-cobertura-interpretacio-linia-20261004":{"findings":[{"anchor":"89d05852c8f6aa2af6a82823","field":"","history":[{"reason":"","revision":48,"status":"pending"}],"id":"denominadors-cobertura-potencia","line":161,"path":"_chapters/ca/04-estadistica-espacial.md","quote":"### Cobertura i valors absents del registre {#controls-demo}","reason":"La presentació barreja cobertura cartogràfica i disponibilitat numèrica de la potència. Falta el 93% global declarat per ICAEN i la dada que els 1340 punts amb POT_KW buit conserven geometria i interval de potència.","resolution_reason":"Contrastats el web i el XML de metadades ICAEN: 93% és cobertura cartogràfica de Catalunya. El GML original confirma 5102 geometries i 1340 elements POT_KW buits, tots amb interval publicat; els valors coincideixen amb el GeoPackage. Text i taula separen els conceptes i declaren la capa disponible com a univers docent.","severity":"minor","status":"resolved","suggestion":"Distingir els dos denominadors, indicar el supòsit docent sobre la capa disponible i evitar presentar els camps buits com instal·lacions absents."},{"anchor":"b941ef68e5500a4134028f88","field":"","history":[{"reason":"","revision":49,"status":"pending"}],"id":"interpretacio-territorial-insuficient","line":219,"path":"_chapters/ca/04-estadistica-espacial.md","quote":"La ponderació el desplaça uns 2.903 m cap a l'oest i lleugerament al sud.","reason":"La xifra descriu un resultat però no desenvolupa prou la informació territorial que aporta ni com es pot comparar amb altres conjunts.","resolution_reason":"Afegides quotes de registres i kW per interpretar el centre comarcal, una figura municipal a escala comuna i una taula de desplaçaments per ponderació. Centres dels 22 municipis contrastats amb native:meancoordinates. Diferenciats punts complets per a dispersió i mateix subconjunt conegut per comparar pesos. Revisats web i PDF233p.","severity":"minor","status":"resolved","suggestion":"Explicar què distingeix el centre dels registres del de la capacitat publicada i incorporar una comparació municipal amb denominadors explícits."}],"id":"c4-cobertura-interpretacio-linia-20261004","kind":"line","profile":"unaltremanual","reviewer":"OpenCode","reviewer_kind":"agent","sequence":46,"source_digest":"8f27bf87ead3875b5f6eddb9e88ce20d5c43e54764cf566bd99d9a886ed80a00","source_hashes":{"_chapters/ca/04-estadistica-espacial.md":"dae39f6874b6d686c9bd11159808b05c89e30377608bff9d9c22f22e5af252f7"},"supersedes":"c4-introduccio-explicativa-linia-20261004","target":"_chapters/ca/04-estadistica-espacial.md"},"c4-cobertura-municipis-evidencia-20261004":{"findings":[],"id":"c4-cobertura-municipis-evidencia-20261004","kind":"evidence","profile":"unaltremanual","reviewer":"OpenCode","reviewer_kind":"agent","sequence":47,"source_digest":"f76ce530b4372a54eadfe77a8a042c94f7850ff377622b2c3f2de09c2213810a","source_hashes":{"_chapters/ca/04-estadistica-espacial.md":"8db251ab75f699dcd73ddccfbd3e511d32d02370286dab1606dbae841627783c"},"supersedes":"punts-tarragones-evidencia-20261004","target":"_chapters/ca/04-estadistica-espacial.md"},"c4-cobertura-municipis-linia-20261004":{"findings":[],"id":"c4-cobertura-municipis-linia-20261004","kind":"line","profile":"unaltremanual","reviewer":"OpenCode","reviewer_kind":"agent","sequence":48,"source_digest":"8a4d6e5db9f14bd812330869d4ca1c97bc423079a85841d0712a97b3ccbc7721","source_hashes":{"_chapters/ca/04-estadistica-espacial.md":"8db251ab75f699dcd73ddccfbd3e511d32d02370286dab1606dbae841627783c"},"supersedes":"c4-cobertura-interpretacio-linia-20261004","target":"_chapters/ca/04-estadistica-espacial.md"},"c4-constanti-escenaris-estructura-20261004":{"findings":[],"id":"c4-constanti-escenaris-estructura-20261004","kind":"structure","profile":"unaltremanual","reviewer":"OpenCode","reviewer_kind":"agent","sequence":53,"source_digest":"079d5c81f75173d7302390c0cdbd9cfd8d28ac59b42f44929949007f421c3e4d","source_hashes":{"_chapters/ca/04-estadistica-espacial.md":"f0d3c32b8c6bde19ec37c508a5a6664dd113550ed80c33aa0d8e5c8e66c6c418"},"supersedes":"c4-municipis-escenaris-estructura-20261004","target":"_chapters/ca/04-estadistica-espacial.md"},"c4-constanti-escenaris-evidencia-20261004":{"findings":[],"id":"c4-constanti-escenaris-evidencia-20261004","kind":"evidence","profile":"unaltremanual","reviewer":"OpenCode","reviewer_kind":"agent","sequence":52,"source_digest":"97e9dcc34643f9144f1235d071dc2521831dfd588f4f46466d9d400555d0a433","source_hashes":{"_chapters/ca/04-estadistica-espacial.md":"f0d3c32b8c6bde19ec37c508a5a6664dd113550ed80c33aa0d8e5c8e66c6c418"},"supersedes":"c4-cobertura-municipis-evidencia-20261004","target":"_chapters/ca/04-estadistica-espacial.md"},"c4-introduccio-explicativa-linia-20261004":{"findings":[],"id":"c4-introduccio-explicativa-linia-20261004","kind":"line","profile":"unaltremanual","reviewer":"OpenCode","reviewer_kind":"agent","sequence":44,"source_digest":"8f27bf87ead3875b5f6eddb9e88ce20d5c43e54764cf566bd99d9a886ed80a00","source_hashes":{"_chapters/ca/04-estadistica-espacial.md":"dae39f6874b6d686c9bd11159808b05c89e30377608bff9d9c22f22e5af252f7"},"supersedes":"c4-introduccio-referents-linia-20261004","target":"_chapters/ca/04-estadistica-espacial.md"},"c4-introduccio-referents-linia-20261004":{"findings":[{"anchor":"ea2e5f38d1cb9a73c42fa088","field":"","history":[{"reason":"","revision":44,"status":"pending"}],"id":"anticipacio-de-referents","line":17,"path":"_chapters/ca/04-estadistica-espacial.md","quote":"El cas de **John Snow i el còlera de Londres** introdueix aquesta lectura crítica; els exemples petits i l'aplicació QGIS al registre d'autoconsum de l'ICAEN permeten practicar-la.","reason":"La introducció anuncia casos, dades i eines encara no presentats. Pressuposa que el lector pot interpretar-ne la funció abans de llegir el capítol, en lloc de desenvolupar una explicació autònoma.","resolution_reason":"Reescrit el paràgraf com una explicació autònoma: recompte de biblioteques, separació entre elles i diferència entre descriure la distribució i explicar-ne les causes. Ja no anuncia Snow, ICAEN, QGIS ni un recorregut de lectura. Criteri incorporat al perfil; prosa i qualitat de fonts correctes.","severity":"minor","status":"resolved","suggestion":"Explicar què afegeix la localització al recompte dels elements, amb les biblioteques ja introduïdes com a referent. Reservar Snow, ICAEN i QGIS per als apartats on es presenten."}],"id":"c4-introduccio-referents-linia-20261004","kind":"line","profile":"unaltremanual","reviewer":"OpenCode","reviewer_kind":"agent","sequence":43,"source_digest":"7dbfca41dead255a4d3c921b5fe112853259b7abe7bf26ef47aa08254b175885","source_hashes":{"_chapters/ca/04-estadistica-espacial.md":"4384df7e79a0f41f63431888fb265039dcd90980f037a2701f2c403e95bfb318"},"supersedes":"","target":"_chapters/ca/04-estadistica-espacial.md"},"c4-municipis-escenaris-estructura-20261004":{"findings":[{"anchor":"1e85a917fb0486b5eae15809","field":"","history":[{"reason":"","revision":54,"status":"pending"}],"id":"cas-principal-comarcal","line":202,"path":"_chapters/ca/04-estadistica-espacial.md","quote":"Els dos centres de comparació utilitzen **ICAEN coneguda**, amb els mateixos 3.762 registres.","reason":"La pràctica principal encara utilitza tota la comarca; la comparació municipal és una ampliació tardana. Això no respon prou a la demanda de resultats reconeixibles i interpretables pels estudiants.","resolution_reason":"Constantí és ara el cas principal: 124 punts, ortofoto, àrees proporcionals i atribució explícita de la influència als pesos. Cinc captures municipals noves i dues figures interpretatives; comparació amb el Morell i el Catllar. La comarca queda com a referència posterior i ampliació per a densitat/agregació. Web i PDF235p revisats.","severity":"major","status":"resolved","suggestion":"Fer de Constantí el cas guiat, relacionar punts i pesos amb el context cartogràfic, i usar el Morell i el Catllar per comparar distribucions."},{"anchor":"d4712663847b5429c59fe35d","field":"","history":[{"reason":"","revision":55,"status":"pending"}],"id":"intervals-sense-escenaris","line":174,"path":"_chapters/ca/04-estadistica-espacial.md","quote":"No s'assigna una potència inventada als camps buits.","reason":"La formulació no distingeix inventar observacions de definir una imputació docent explícita a partir dels intervals disponibles.","resolution_reason":"POT_KW es conserva i només es completen els buits en w_inf/w_mid/w_sup. Verificats els 672 registres, els 12 centres natius, les sumes i la sensibilitat. El zero és un valor límit, el punt mitjà no és una mitjana observada i el cas obert de Torredembarra queda separat. Sumes i posicions es presenten com escenaris, no dades noves ni intervals de confiança.","severity":"minor","status":"resolved","suggestion":"Preservar POT_KW i crear camps separats per als escenaris inferior, central i superior; comprovar la sensibilitat i tractar separadament la classe oberta."}],"id":"c4-municipis-escenaris-estructura-20261004","kind":"structure","profile":"unaltremanual","reviewer":"OpenCode","reviewer_kind":"agent","sequence":51,"source_digest":"9f6d8c07701c97f8eb89c16350d7dd76df1886363bf4ddda5ecd6d2f51b7a138","source_hashes":{"_chapters/ca/04-estadistica-espacial.md":"8db251ab75f699dcd73ddccfbd3e511d32d02370286dab1606dbae841627783c"},"supersedes":"punts-tarragones-estructura-20261004","target":"_chapters/ca/04-estadistica-espacial.md"},"c4-progressio-titols-estructura-20261004":{"findings":[{"anchor":"f679fdf49d053046168fa56d","field":"","history":[{"reason":"","revision":31,"status":"pending"}],"id":"introduccio-sense-orientacio","line":15,"path":"_chapters/ca/04-estadistica-espacial.md","quote":"Un mapa amb molts establiments petits i pocs de grans pot mostrar una concentració de punts diferent de la concentració d'activitat.","reason":"La primera frase pressuposa la distinció entre recompte i ponderació abans de presentar què és una distribució puntual, les preguntes del capítol i la rellevància del cas de Snow.","resolution_reason":"Nova introducció amb situacions recognoscibles, significat dels resums i orientació de lectura. Snow és ara el primer cas, amb la seva importància explicada; els centres es desenvolupen amb nombres abans de fórmules i de la preparació ICAEN. Resultat comprovat al PDF de 231 pàgines.","severity":"major","status":"resolved","suggestion":"Introduir la distribució de punts amb situacions recognoscibles, situar Snow i explicar les preguntes de localització, dispersió i densitat abans de la ponderació."},{"anchor":"85ae2475aea3ca2f4a1a561d","field":"","history":[{"reason":"","revision":32,"status":"pending"}],"id":"titols-transicio-buits","line":27,"path":"_chapters/ca/04-estadistica-espacial.md","quote":"## Del mapa de punts a una pregunta estadística {#preguntes-punts}","reason":"El títol expressa una transició genèrica i no identifica el concepte central ni la funció de la secció. El mateix patró apareix en altres encapçalaments.","resolution_reason":"Substituïts els títols de transició dels capítols 1, 4, 5, 6 i 7 per conceptes o funcions precises. Perfil reforçat amb revisió semàntica; conservats i comprovats els ancoratges anteriors. Les activitats de graella i kernel ara tenen títols i continguts corresponents.","severity":"minor","status":"resolved","suggestion":"Substituir-lo per un títol sobre patrons puntuals, unitats i ponderació; revisar semànticament els altres H2/H3 i conservar els ancoratges."},{"anchor":"14d98a209f13659c01fe13c6","field":"","history":[{"reason":"","revision":33,"status":"pending"}],"id":"credits-al-cos","line":53,"path":"_chapters/ca/04-estadistica-espacial.md","quote":"La imatge procedeix de la [fitxa de Wikimedia Commons](https://commons.wikimedia.org/wiki/File:Snow-cholera-map-1.jpg), que identifica l'obra i la seva reproducció com a **[domini públic](https://creativecommons.org/publicdomain/mark/1.0/)**.","reason":"La informació de propietat i reproducció interromp el fil docent i duplica el crèdit del peu de figura.","resolution_reason":"Procedència, atribució i enllaços de drets de Snow i Wald traslladats a data-caption-source. Eliminats els paràgrafs administratius del cos i comprovats els enllaços dins dels crèdits HTML i al PDF. Imatges sense canvis de bytes.","severity":"minor","status":"resolved","suggestion":"Conservar autoria, procedència i enllaços de drets a data-caption-source; reservar el cos per interpretar el mapa."},{"anchor":"4bf1acdab2018d0fad1db9f5","field":"","history":[{"reason":"","revision":34,"status":"pending"}],"id":"versio-qgis-repetida","line":195,"path":"_chapters/ca/04-estadistica-espacial.md","quote":"Coordenades mitjanes amb QGIS 3.44.11.","reason":"La versió comuna ja és al capítol0; repetir-la al peu desplaça informació docent sobre què es compara.","resolution_reason":"Retirades les versions redundants dels peus de centres i buffers. La referència QGIS 3.44 LTR es conserva al capítol 0; versions exactes als manifests. Els 14 peus nous expliquen entrada, paràmetres o resultat sense repetir la versió.","severity":"minor","status":"resolved","suggestion":"Eliminar la versió del peu, mantenir la versió de referència al capítol0 i els detalls exactes als registres de reproducció."}],"id":"c4-progressio-titols-estructura-20261004","kind":"structure","profile":"unaltremanual","reviewer":"OpenCode","reviewer_kind":"agent","sequence":31,"source_digest":"cb441636e064edc641d4bc1223421e7a2c570ebc56c243bbea2dbf3093852524","source_hashes":{"_chapters/ca/04-estadistica-espacial.md":"fc768638a5dca7125508e380de19417fb9785f4be0a290c6aecba00edb93807d"},"supersedes":"","target":"_chapters/ca/04-estadistica-espacial.md"},"c5-qgis-primer-copia-20261004":{"findings":[],"id":"c5-qgis-primer-copia-20261004","kind":"copy","profile":"unaltremanual","reviewer":"OpenCode","reviewer_kind":"agent","sequence":54,"source_digest":"40831b76a7be8cd0fc4f1741ea23c79b7bbfcd3ede98b79f9eba2e7e5a0e947a","source_hashes":{"_chapters/ca/05-autocorrelacio-espacia